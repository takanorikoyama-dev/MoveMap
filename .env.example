# --- 必須 ---
# e-Stat AppID(https://www.e-stat.go.jp/api/ で無料発行)
ESTAT_APP_ID=

# --- 任意 ---
# DuckDB ファイルパス(デフォルトは data/movemap.duckdb)
MOVEMAP_DB_PATH=data/movemap.duckdb

# ログレベル(DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# --- 外部 API キー(無料、無いと該当指標がダミー or 未取得になる) ---
# 国土交通省 不動産情報ライブラリ(地価データ、申請後 5 営業日で発行)
REINFOLIB_API_KEY=

# WAQI 大気質指数(空気質データ、即時発行 https://aqicn.org/data-platform/token/)
WAQI_TOKEN=

# ngrok Authtoken (スマホからの一時公開用、即時 https://dashboard.ngrok.com/)
NGROK_AUTHTOKEN=

# --- アクセス解析(任意) ---
# Google Analytics 4 Measurement ID(G-XXXXXXXXXX 形式)
# 設定するとサイト訪問・操作の集計が GA4 ダッシュボードで見られる
GA4_MEASUREMENT_ID=
